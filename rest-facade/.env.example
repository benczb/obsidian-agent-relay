# Standalone REST only. Copy to rest-facade/.env in the checkout (Git ignores it);
# point the two data paths outside the checkout and any synced vault credentials.
OBSIDIAN_VAULT_PATH=/absolute/path/to/private-notes-vault
KANBAN_BOARD_DIR=/absolute/path/to/private-board
REST_BEARER_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32_REST
REST_BIND_PORT=8788
OBSIDIAN_ATTACHMENTS_FOLDER=Attachments
