[Unit]
Description=Obsidian Kanban REST facade (Meta Muse custom connector)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Adjust if cloned somewhere other than ~/obsidian-agent-relay.
# Copy and edit rest-facade/.env before enabling this unit.
WorkingDirectory=%h/obsidian-agent-relay
ExecStart=/usr/bin/docker compose --env-file rest-facade/.env -f rest-facade/compose.yaml up -d
ExecStop=/usr/bin/docker compose --env-file rest-facade/.env -f rest-facade/compose.yaml down
TimeoutStartSec=0

[Install]
WantedBy=default.target
