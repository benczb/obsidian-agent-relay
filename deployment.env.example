# Copy outside the repository and replace every placeholder before starting.
# Keep the board and notes in separate directories outside this checkout.
KANBAN_BOARD_DIR=/absolute/path/to/private-board
OBSIDIAN_VAULT_PATH=/absolute/path/to/private-notes-vault
KANBAN_RUNTIME_PATH=/absolute/path/to/private-runtime
MCP_BEARER_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32_MCP
REST_BEARER_TOKEN=REPLACE_WITH_DIFFERENT_OPENSSL_RAND_HEX_32_REST
PUBLIC_BASE_URL=https://YOUR-OAUTH-HOST.example.com:YOUR-HTTPS-PORT
OAUTH_ALLOWED_REDIRECT_HOSTS=YOUR-VERIFIED-CLIENT-CALLBACK-HOST.example.com
MCP_BIND_PORT=18787
OAUTH_BIND_PORT=8771
REST_BIND_PORT=18788
OBSIDIAN_ATTACHMENTS_FOLDER=Attachments
